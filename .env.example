# Copy to `.env` and adjust for your machine. `.env` is git-ignored.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- Local infrastructure (docker-compose.yml) -----------------------------
POSTGRES_USER=axa
POSTGRES_PASSWORD=axa
POSTGRES_DB=axa_admin
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Backend (apps/api) ----------------------------------------------------
API_PORT=4000
DATABASE_URL=postgresql://axa:axa@localhost:5432/axa_admin?schema=public
REDIS_URL=redis://localhost:6379

# JWT signing secret. Generate a unique value per environment.
JWT_SECRET=replace-me
JWT_EXPIRES_IN=15m

# --- Frontend (apps/web) ---------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Integrations (added in later phases) ----------------------------------
# GITHUB_APP_ID=
# GITHUB_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# TEAMS_WEBHOOK_URL=
