// AXA Admin data model.
//
// Note: as of Prisma 7 the connection URL lives in `prisma.config.ts`, not
// here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// The tenant root.
///
/// Every tenant-owned record points back to an organization through
/// `organizationId`, which is the column that will carry tenant isolation.
/// The application currently operates on a single organization; the schema is
/// shaped so that lifting that restriction later is an application change
/// rather than a migration of every table.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  /// The letters in front of an issue key, as in `AXA-123`.
  ///
  /// Per tenant rather than per project: the branch names this has to match
  /// carry one prefix, and a second one would make `feat/AXA-123-...`
  /// ambiguous the moment two projects both had an issue 123.
  issuePrefix  String @default("AXA")
  /// The last number handed out. Incremented inside the transaction that
  /// creates an issue, so the row lock serialises concurrent creates.
  issueCounter Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyReports DailyReport[]
  workspaces    Workspace[]
  users         User[]
  teamMembers   TeamMember[]
  appOwnerships AppOwnership[]
  projects      Project[]
  issues        Issue[]
  labels        Label[]
  activity   ActivityEvent[]
  githubRepositories GithubRepository[]
  githubLinks        GithubLink[]

  @@map("organizations")
}

/// A container inside an organization that will own projects, issues and
/// cycles, letting one tenant separate divisions or product lines.
model Workspace {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  slug           String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]
  issues       Issue[]
  labels       Label[]
  activity     ActivityEvent[]

  // Slugs are unique per tenant, not globally, so two organizations can both
  // have a "core" workspace.
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

/// A person who can sign in to AXA Admin.
///
/// Scoped to an organization for the same reason as everything else. Roles and
/// permissions are deliberately absent — they belong to the permissions work,
/// not to the base schema.
model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  email          String
  name           String
  /// bcrypt hash. Never selected into a response — see `AuthService`.
  passwordHash   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedIssues Issue[]
  dailyReports   DailyReport[]
  teamMember     TeamMember?
  activity       ActivityEvent[]

  // Unique per tenant rather than globally, so the same address can exist in
  // two organizations once multi-tenancy is switched on.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

/// A body of work inside a workspace that groups issues.
model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  workspaceId    String        @db.Uuid
  name           String
  description    String?
  status         ProjectStatus @default(backlog)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues       Issue[]

  @@index([organizationId])
  @@index([workspaceId])
  @@map("projects")
}

enum ProjectStatus {
  backlog
  planned
  in_progress
  paused
  completed
  cancelled

  @@map("project_status")
}

/// A unit of work.
model Issue {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  workspaceId    String        @db.Uuid
  /// The human-readable reference, as in `AXA-123`.
  ///
  /// What a branch name, a pull request title or a person in a meeting can
  /// actually say. A UUID cannot be any of those, which is why linking a
  /// branch to an issue needs this to exist at all.
  key            String
  /// Null while an issue sits in the workspace backlog, unattached to a project.
  projectId      String?       @db.Uuid
  title          String
  description    String?
  status         IssueStatus   @default(backlog)
  priority       IssuePriority @default(none)
  /// Null when unassigned. Set to null rather than deleting the issue when the
  /// assignee leaves.
  assigneeId     String?       @db.Uuid
  /// The AXA application this issue delivers against, when it targets one.
  app            AppKey?
  /// When the issue last moved into `done`. Null while it is open, and set back
  /// to null if it is reopened. Distinct from `updatedAt`, which any later edit
  /// moves — renaming a finished issue must not change the day it was closed.
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee     User?              @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  labels       IssueLabel[]
  dailyReports DailyReportIssue[]
  githubLinks  GithubLink[]
  activity     ActivityEvent[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([assigneeId])
  // One `AXA-123` per tenant, and the lookup a branch name resolves through.
  @@unique([organizationId, key])
  // Board and list views read one workspace filtered by status constantly.
  @@index([workspaceId, status])
  // "What did this person close on this day" — the daily report prefill.
  @@index([organizationId, closedAt])
  @@map("issues")
}

enum IssueStatus {
  backlog
  todo
  in_progress
  in_review
  done
  cancelled

  @@map("issue_status")
}

/// Ordered from lowest to highest, matching the keyboard-first convention where
/// priority is cycled through in this sequence.
enum IssuePriority {
  none
  low
  medium
  high
  urgent

  @@map("issue_priority")
}

/// The applications in the AXA ecosystem an issue can be linked to.
enum AppKey {
  axa_admin
  axacrm
  axapass
  website

  @@map("app_key")
}

/// A tag that can be applied to issues.
model Label {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  name           String
  /// Hex colour, e.g. `#5E6AD2`.
  color          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues       IssueLabel[]

  // Label names are unique per workspace, so two workspaces can each have a
  // "bug" label.
  @@unique([workspaceId, name])
  @@index([organizationId])
  @@map("labels")
}

/// Join between issues and labels.
///
/// Explicit rather than an implicit many-to-many so the table is named, is
/// indexed on both sides, and can carry columns later (who applied the label,
/// and when) without a rename.
model IssueLabel {
  issueId String @db.Uuid
  labelId String @db.Uuid

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
  @@map("issue_labels")
}

/// A developer's update for one working day.
///
/// The structured replacement for an ad hoc chat message: the same three
/// questions every day, so a team leader can read a week without re-reading a
/// conversation.
model DailyReport {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  /// The developer the report is from.
  authorId       String   @db.Uuid
  /// The working day covered, with no time component.
  reportDate     DateTime @db.Date
  /// What was shipped today.
  shipped        String
  /// What is blocked. Null when nothing is — "no blockers" and "did not say"
  /// are different answers, and a team leader needs to tell them apart.
  blocked        String?
  /// What they are working on next.
  next           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  issues       DailyReportIssue[]

  // One report per person per day: a second one is an edit, not a new report.
  @@unique([authorId, reportDate])
  // The digest reads one tenant for one day.
  @@index([organizationId, reportDate])
  @@map("daily_reports")
}

/// Join between a daily report and the issues it refers to.
///
/// Explicit rather than an implicit many-to-many so the table is named and can
/// carry columns later without a rename.
model DailyReportIssue {
  reportId String @db.Uuid
  issueId  String @db.Uuid

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  issue  Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([reportId, issueId])
  @@index([issueId])
  @@map("daily_report_issues")
}
/// A person's place on the team, and the role they hold by default.
///
/// Deliberately separate from `User`, which is the sign-in identity. Whether
/// AXA adopts shared authentication across the ecosystem is still an open
/// decision; if it does, `User` loses its tenant column and this becomes the
/// record that ties an identity to an organization. Keeping them apart now
/// means that change does not have to move roles at the same time.
model TeamMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  /// Applies wherever no per-application ownership overrides it.
  role           Role     @default(viewer)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerships   AppOwnership[]

  // One membership per person per tenant.
  @@unique([userId])
  @@index([organizationId])
  @@map("team_members")
}

/// The role a member holds for one application.
///
/// This is the `role x app` scoping the permission model calls for: a member
/// can lead `axapass` while only reading `axacrm`. A member with no row for an
/// application falls back to `TeamMember.role`.
model AppOwnership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  teamMemberId   String   @db.Uuid
  app            AppKey
  role           Role
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMember   TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  // One role per member per application; a second row would make the effective
  // role ambiguous.
  @@unique([teamMemberId, app])
  @@index([organizationId])
  @@index([app])
  @@map("app_ownerships")
}

/// The fixed system roles.
///
/// A closed set on purpose: the plan is to start with fixed roles and add a
/// customizable role editor later. Promoting this to a table is a migration
/// when that day comes, which is the price of not building an editor nobody
/// has asked for yet.
enum Role {
  owner
  pm_lead
  dev_team_leader
  developer
  designer
  viewer

  @@map("role")
}
/// An entry in the activity feed.
///
/// Append-only: there is no `updatedAt` and nothing rewrites a row. A
/// correction is a new event, which is what makes the feed usable as a record
/// of what happened rather than of what things look like now.
model ActivityEvent {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  workspaceId    String            @db.Uuid
  issueId        String            @db.Uuid
  type           ActivityEventType
  /// The member who caused the event. Null for events raised by automation.
  actorId        String?           @db.Uuid
  /// Type-specific detail, e.g. `{ "from": "todo", "to": "in_progress" }`.
  payload        Json
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue        Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  // The feed is always read for one issue, newest first.
  @@index([issueId, createdAt])
  @@map("activity_events")
}

enum ActivityEventType {
  issue_status_changed
  issue_assigned
  issue_commented

  @@map("activity_event_type")
}

/// A GitHub repository connected to a tenant.
///
/// A webhook delivery carries a repository and nothing else — no organization,
/// no account, nothing that says who it is for. This table is what answers
/// that, and without it a delivery could only be attributed by assuming there
/// is one tenant.
model GithubRepository {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  /// `owner/name`, exactly as GitHub reports it in `repository.full_name`.
  fullName       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Globally unique, not per tenant: a delivery names only the repository, so
  // if two tenants claimed the same one there would be no way to choose.
  @@unique([fullName])
  @@index([organizationId])
  @@map("github_repositories")
}

enum GithubLinkKind {
  pull_request
  issue

  @@map("github_link_kind")
}

/// A GitHub pull request or issue that refers to one of ours.
///
/// Written by the webhook when a branch name or a title mentions an issue key.
model GithubLink {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  issueId        String         @db.Uuid
  kind           GithubLinkKind
  repository     String
  number         Int
  title          String
  url            String
  /// GitHub's own words: `open`, `closed`, and `merged` for a merged pull
  /// request, which GitHub itself reports as closed with a flag.
  state          String
  /// The head branch, for a pull request. Null for an issue.
  branch         String?
  mergedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issue        Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)

  // One link per GitHub object per issue, so a redelivery or a later event on
  // the same pull request updates the row rather than adding another.
  @@unique([repository, kind, number, issueId])
  @@index([organizationId])
  @@index([issueId])
  @@map("github_links")
}
