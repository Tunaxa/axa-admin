// AXA Admin data model.
//
// Note: as of Prisma 7 the connection URL lives in `prisma.config.ts`, not
// here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// The tenant root.
///
/// Every tenant-owned record points back to an organization through
/// `organizationId`, which is the column that will carry tenant isolation.
/// The application currently operates on a single organization; the schema is
/// shaped so that lifting that restriction later is an application change
/// rather than a migration of every table.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces    Workspace[]
  users         User[]
  teamMembers   TeamMember[]
  appOwnerships AppOwnership[]
  projects      Project[]
  issues        Issue[]
  labels        Label[]
  activity   ActivityEvent[]

  @@map("organizations")
}

/// A container inside an organization that will own projects, issues and
/// cycles, letting one tenant separate divisions or product lines.
model Workspace {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  slug           String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]
  issues       Issue[]
  labels       Label[]
  activity     ActivityEvent[]

  // Slugs are unique per tenant, not globally, so two organizations can both
  // have a "core" workspace.
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

/// A person who can sign in to AXA Admin.
///
/// Scoped to an organization for the same reason as everything else. Roles and
/// permissions are deliberately absent — they belong to the permissions work,
/// not to the base schema.
model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  email          String
  name           String
  /// bcrypt hash. Never selected into a response — see `AuthService`.
  passwordHash   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedIssues Issue[]
  teamMember     TeamMember?
  activity       ActivityEvent[]

  // Unique per tenant rather than globally, so the same address can exist in
  // two organizations once multi-tenancy is switched on.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

/// A body of work inside a workspace that groups issues.
model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  workspaceId    String        @db.Uuid
  name           String
  description    String?
  status         ProjectStatus @default(backlog)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues       Issue[]

  @@index([organizationId])
  @@index([workspaceId])
  @@map("projects")
}

enum ProjectStatus {
  backlog
  planned
  in_progress
  paused
  completed
  cancelled

  @@map("project_status")
}

/// A unit of work.
model Issue {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  workspaceId    String        @db.Uuid
  /// Null while an issue sits in the workspace backlog, unattached to a project.
  projectId      String?       @db.Uuid
  title          String
  description    String?
  status         IssueStatus   @default(backlog)
  priority       IssuePriority @default(none)
  /// Null when unassigned. Set to null rather than deleting the issue when the
  /// assignee leaves.
  assigneeId     String?       @db.Uuid
  /// The AXA application this issue delivers against, when it targets one.
  app            AppKey?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee     User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  labels       IssueLabel[]
  activity     ActivityEvent[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([assigneeId])
  // Board and list views read one workspace filtered by status constantly.
  @@index([workspaceId, status])
  @@map("issues")
}

enum IssueStatus {
  backlog
  todo
  in_progress
  in_review
  done
  cancelled

  @@map("issue_status")
}

/// Ordered from lowest to highest, matching the keyboard-first convention where
/// priority is cycled through in this sequence.
enum IssuePriority {
  none
  low
  medium
  high
  urgent

  @@map("issue_priority")
}

/// The applications in the AXA ecosystem an issue can be linked to.
enum AppKey {
  axa_admin
  axacrm
  axapass
  website

  @@map("app_key")
}

/// A tag that can be applied to issues.
model Label {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  name           String
  /// Hex colour, e.g. `#5E6AD2`.
  color          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues       IssueLabel[]

  // Label names are unique per workspace, so two workspaces can each have a
  // "bug" label.
  @@unique([workspaceId, name])
  @@index([organizationId])
  @@map("labels")
}

/// Join between issues and labels.
///
/// Explicit rather than an implicit many-to-many so the table is named, is
/// indexed on both sides, and can carry columns later (who applied the label,
/// and when) without a rename.
model IssueLabel {
  issueId String @db.Uuid
  labelId String @db.Uuid

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
  @@map("issue_labels")
}

/// A person's place on the team, and the role they hold by default.
///
/// Deliberately separate from `User`, which is the sign-in identity. Whether
/// AXA adopts shared authentication across the ecosystem is still an open
/// decision; if it does, `User` loses its tenant column and this becomes the
/// record that ties an identity to an organization. Keeping them apart now
/// means that change does not have to move roles at the same time.
model TeamMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  /// Applies wherever no per-application ownership overrides it.
  role           Role     @default(viewer)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerships   AppOwnership[]

  // One membership per person per tenant.
  @@unique([userId])
  @@index([organizationId])
  @@map("team_members")
}

/// The role a member holds for one application.
///
/// This is the `role x app` scoping the permission model calls for: a member
/// can lead `axapass` while only reading `axacrm`. A member with no row for an
/// application falls back to `TeamMember.role`.
model AppOwnership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  teamMemberId   String   @db.Uuid
  app            AppKey
  role           Role
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMember   TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  // One role per member per application; a second row would make the effective
  // role ambiguous.
  @@unique([teamMemberId, app])
  @@index([organizationId])
  @@index([app])
  @@map("app_ownerships")
}

/// The fixed system roles.
///
/// A closed set on purpose: the plan is to start with fixed roles and add a
/// customizable role editor later. Promoting this to a table is a migration
/// when that day comes, which is the price of not building an editor nobody
/// has asked for yet.
enum Role {
  owner
  pm_lead
  dev_team_leader
  developer
  designer
  viewer

  @@map("role")
/// An entry in the activity feed.
///
/// Append-only: there is no `updatedAt` and nothing rewrites a row. A
/// correction is a new event, which is what makes the feed usable as a record
/// of what happened rather than of what things look like now.
model ActivityEvent {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  workspaceId    String            @db.Uuid
  issueId        String            @db.Uuid
  type           ActivityEventType
  /// The member who caused the event. Null for events raised by automation.
  actorId        String?           @db.Uuid
  /// Type-specific detail, e.g. `{ "from": "todo", "to": "in_progress" }`.
  payload        Json
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue        Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  // The feed is always read for one issue, newest first.
  @@index([issueId, createdAt])
  @@map("activity_events")
}

enum ActivityEventType {
  issue_status_changed
  issue_assigned
  issue_commented

  @@map("activity_event_type")
}
