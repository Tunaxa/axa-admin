# Copy to `backend/.env`. `.env` is git-ignored.

# Must match the credentials in the repository-root docker-compose.yml.
DATABASE_URL="postgresql://axa:axa@localhost:5433/axa_admin?schema=public"

# The docs module's page tree and content blocks. Must match the credentials
# in the repository-root docker-compose.yml.
MONGODB_URL="mongodb://axa:axa@localhost:27018/axa_admin_docs?authSource=admin"

# Access-token signing secret. Generate a unique value per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me"
JWT_EXPIRES_IN="15m"

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS="http://localhost:3000"

# Microsoft Teams incoming webhook, from the channel's Workflows connector.
# Optional: leave it unset and notifications are simply off. The URL carries a
# secret, so it belongs here and never in the repository.
TEAMS_WEBHOOK_URL=""

# Stripe. Without a secret key the billing routes answer 503 — unlike the Teams
# webhook, a checkout session nobody can get is a failure, not silence.
# The key is a credential: it belongs here and never in the repository.
STRIPE_SECRET_KEY=""
# Where Stripe returns the customer. Configured rather than sent by the caller,
# so this cannot become an open redirect that Stripe itself walks people through.
STRIPE_SUCCESS_URL="http://localhost:3000/billing/done"
STRIPE_CANCEL_URL="http://localhost:3000/billing/cancelled"
# Only for pointing the SDK at a stand-in during testing. Unset in every real
# environment, where the SDK talks to api.stripe.com over TLS.
STRIPE_API_HOST=""
STRIPE_API_PORT=""
